# env file with version control for local and non-sensitive variables

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin

# Config Server
CONFIG_SERVER_URL=http://config-server:8071

# Registry Server
REGISTRY_SERVER_URL=http://registry-server:8761/eureka/
GIT_REPO_URI=https://github.com/FirasKhalife/fyp-grading-config.git
GIT_BRANCH=main

# Spring
SPRING_PROFILES_ACTIVE=prod

# Docker Infrastructure
GLOBAL_NETWORK_NAME=fyp-grading
PROJECT_NAME=fyp-grading

# Service Names
API_GATEWAY_NAME=api-gateway
REGISTRY_SERVER_NAME=registry-server
CONFIG_SERVER_NAME=config-server
ADMIN_SERVICE_NAME=admin-service
EVALUATION_SERVICE_NAME=evaluation-service
NOTIFICATION_SERVICE_NAME=notification-service
RUBRIC_SERVICE_NAME=rubric-service
FRONTEND_SERVICE_NAME=frontend

# Redis
REDIS_PASSWORD=admin
