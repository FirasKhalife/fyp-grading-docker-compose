{
  "realm": "assay",
  "displayName": "Assay",
  "loginTheme": "assay",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Coordinator: sees every team, edits rubrics, schedules, releases results"
      },
      {
        "name": "REVIEWER",
        "description": "Faculty member who grades teams (jury or advisor per team)"
      },
      {
        "name": "STUDENT",
        "description": "Team member: sees their team and released results"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-assay",
    "description": "No account-console rights: the demo accounts are shared and must not be editable",
    "composite": false
  },
  "clients": [
    {
      "clientId": "assay-spa",
      "name": "Assay web app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${ASSAY_SPA_ORIGIN:http://localhost:5173}/*"
      ],
      "webOrigins": [
        "+"
      ],
      "rootUrl": "${ASSAY_SPA_ORIGIN:http://localhost:5173}",
      "baseUrl": "/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ASSAY_SPA_ORIGIN:http://localhost:5173}/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email",
        "basic"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    }
  ],
