# Copy to .env (git-ignored) next to compose.yml and fill in. Never commit the filled-in file: the repo is public.
# Generate each secret on the host, e.g.:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# compose.yml refuses to start while a required value is empty.

# The public origin of the demo: the app, the API (/api) and Keycloak's sign-in (/realms/assay) all live on it.
# It is Keycloak's issuer, the SPA client's only redirect origin, and the gateway's CORS origin.
PUBLIC_URL=https://assay.example.dev

# Image tag for every ghcr.io/firaskhalife/* image: latest, or a commit's short SHA to pin a release.
ASSAY_TAG=latest

# Postgres (all four databases) and MongoDB.
DB_USER=assay
DB_PASSWORD=

RABBITMQ_USER=assay
RABBITMQ_PASSWORD=

REDIS_PASSWORD=

# Keycloak's first master-realm admin, created on the first start only. Replace it after the first boot
# (docs/deploy-hardening.md). The admin console is never published: administer with kcadm.sh through
# docker exec, as scripts/keycloak-reset-personas.sh does.
KEYCLOAK_ADMIN_USER=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=

# cloudflared (docker compose --profile tunnel up -d): the token of the tunnel, from the Cloudflare dashboard.
TUNNEL_TOKEN=

# Optional.
# EDGE_PORT=8080                 # the edge on 127.0.0.1 (for cloudflared on the host, or checks over SSH)
# GATEWAY_COPY_RATE=1            # demo copies per second per visitor; 600 lifts the limit for a Playwright run
# CONFIG_GIT_URI=https://github.com/FirasKhalife/fyp-grading-config.git
# CONFIG_GIT_BRANCH=main

# The demo personas' password is "assay-demo". It is public on purpose and is not configured here.
